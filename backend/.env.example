# Copy this file to .env and fill in real values. .env is NEVER committed.

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MySQL (the limited user from database/07_app_user.sql, not root)
DB_HOST=localhost
DB_PORT=3306
DB_USER=utc_app
DB_PASSWORD=Change_This_Password_123
DB_NAME=university_tax

# JWT: a long random secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_HOURS=8

# Daily alert job (cron format, India time). Default: every day at 9:00 AM
ALERT_CRON=0 9 * * *

# Email (optional). Leave SMTP_HOST empty in development: emails are printed
# in the terminal instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Tax Portal <no-reply@taxportal.in>
